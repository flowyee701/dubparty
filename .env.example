# ── Сервер ───────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Публичный адрес (используется в логах и для CORS в продакшене), например https://dub.example.com
PUBLIC_URL=http://localhost:5173
# Разрешённые origin через запятую. Пусто — тот же origin (продакшен) и localhost (dev).
CORS_ORIGINS=
LOG_LEVEL=info
# Доверять заголовкам X-Forwarded-* (включите за обратным прокси: Fly.io, Render, Cloudflare Tunnel)
TRUST_PROXY=false

# ── Данные ───────────────────────────────────────────────────────────────
# SQLite-файл и каталог хранилища. Относительные пути считаются от корня репозитория.
DATA_DIR=./data
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# S3-совместимое хранилище (STORAGE_DRIVER=s3): AWS S3, Cloudflare R2, MinIO, Backblaze B2…
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=

# ── ffmpeg ───────────────────────────────────────────────────────────────
# Пусто — берутся бинарники из npm-пакетов ffmpeg-static / ffprobe-static, затем из PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Сколько задач ffmpeg выполнять одновременно
FFMPEG_CONCURRENCY=2

# ── Очистка ──────────────────────────────────────────────────────────────
# Через сколько часов после окончания игры удалять комнату и её файлы
ROOM_TTL_HOURS=6
# Через сколько часов бездействия удалять комнату, игра в которой не закончилась
ROOM_IDLE_HOURS=12

# ── Лимиты ───────────────────────────────────────────────────────────────
MAX_ROOMS=500
# Максимум файлов и суммарный объём (МБ) на одну комнату
MAX_ROOM_FILES=600
MAX_ROOM_MB=2048
# Запросов в минуту с одного IP (HTTP) и загрузок в минуту
HTTP_RATE_LIMIT=600
UPLOAD_RATE_LIMIT=60

# ── Twitch ───────────────────────────────────────────────────────────────
# Интеграция читает чат анонимно, ключи не нужны. false — выключить совсем.
TWITCH_ENABLED=true
